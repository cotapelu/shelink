// Schema dữ liệu LawLink
// Tương ứng với docs/DATA-MODEL.md v0.3
// Trước khi sửa hãy sửa tài liệu, rồi mới sửa schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Kiểu liệt kê (Enum)
// ============================================================

enum UserRole {
  ADMIN
  PRINCIPAL_LAWYER
  LAWYER
  ASSISTANT
  FINANCE
}

enum MatterCategory {
  CIVIL_COMMERCIAL // Tố tụng dân sự & thương mại
  LABOR_ARBITRATION // v0.34 Trọng tài lao động
  COMMERCIAL_ARBITRATION // v0.34 Trọng tài thương mại
  CRIMINAL // Tố tụng hình sự
  ADMINISTRATIVE // Tố tụng hành chính
  NON_LITIGATION // Việc ngoài tố tụng
  LEGAL_COUNSEL // Cố vấn thường trực
  SPECIAL_PROJECT // Dự án pháp lý chuyên sâu
}

enum MatterStatus {
  PENDING_ACCEPTANCE
  IN_PROGRESS
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum MatterMemberRole {
  LEAD
  CO_LEAD
  ASSISTANT
}

// Genealogy & ERP enums
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RelationType {
  PARENT_CHILD
  SPOUSE
  SIBLING
  GRANDPARENT
  GRANDCHILD
  UNCLE_AUNT
  NEPHEW_NIECE
  COUSIN
  PARTNER
  GUARDIAN
  WARD
}

enum EventType {
  BIRTH
  DEATH
  MARRIAGE
  DIVORCE
  ADOPTION
  MIGRATION
  EDUCATION
  EMPLOYMENT
  MEDICAL
  CUSTOM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum WorkflowState {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum WorkflowStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum IntakeStatus {
  INTAKE
  PENDING_CONFIRMATION
  CONVERTED
  DECLINED // Từ chối dứt khoát (không thể bổ sung)
  NEEDS_REVISION // Chờ bổ sung (luật sư bổ sung tài liệu rồi gửi duyệt lại)
}

enum LitigationStanding {
  PLAINTIFF
  JOINT_PLAINTIFF
  DEFENDANT
  JOINT_DEFENDANT
  THIRD_PARTY
  COUNTERCLAIM_PLAINTIFF
  COUNTERCLAIM_DEFENDANT
  // v0.5: Phúc thẩm / Giám đốc thẩm / Thi hành án
  APPELLANT
  APPELLEE
  RETRIAL_APPLICANT
  RETRIAL_RESPONDENT
  ENFORCEMENT_APPLICANT
  EXECUTED_PERSON
  // Hình sự
  CRIMINAL_DEFENDANT
  CRIMINAL_VICTIM
  PRIVATE_PROSECUTOR
  CRIMINAL_INCIDENTAL_PLAINTIFF
  // Trọng tài
  ARBITRATION_CLAIMANT
  ARBITRATION_RESPONDENT
  // Hành chính
  ADMIN_PLAINTIFF
  ADMIN_DEFENDANT
  ADMIN_RECONSIDERATION_APPLICANT
  ADMIN_RECONSIDERATION_RESPONDENT
  // Ngoài tố tụng
  NON_LITIGATION_PARTY
}

enum FeeType {
  FIXED // Thu phí cố định
  CONTINGENCY // Đại diện theo rủi ro (success fee)
  TIMED // Thu phí theo thời gian
}

enum InvoiceType {
  PLAIN // Hóa đơn thông thường
  SPECIAL // Hóa đơn GTGT đặc biệt
}

enum InvoiceItem {
  LAWYER_FEE // Phí dịch vụ luật sư
  CONSULTING_FEE // Phí tư vấn pháp luật
  AGENCY_FEE // Phí đại diện
  OTHER // Dịch vụ pháp lý khác
}

enum InvoiceRequestStatus {
  PENDING // Luật sư đã yêu cầu, chờ Tài chính xử lý
  APPROVED // Tài chính đã duyệt, chờ xuất hóa đơn
  ISSUED // Đã xuất (gồm hóa đơn điện tử)
  REJECTED // Bị từ chối
}

// v0.10: Trạng thái duyệt văn bản
enum DocumentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  FILED
}

enum ProcedureType {
  // Dùng chung cho xét xử
  FIRST_INSTANCE
  SECOND_INSTANCE
  RETRIAL_REVIEW
  RETRIAL
  REMAND_FIRST
  REMAND_SECOND
  PROSECUTORIAL_SUPERVISION
  // Trọng tài
  COMMERCIAL_ARBITRATION
  LABOR_ARBITRATION
  ARBITRATION_SET_ASIDE
  ARBITRATION_ENFORCEMENT_REVIEW
  // Thi hành án
  ENFORCEMENT
  ENFORCEMENT_OBJECTION
  // Hình sự
  INVESTIGATION
  PROSECUTION_REVIEW
  DEATH_PENALTY_REVIEW
  CRIMINAL_ENFORCEMENT
  COMMUTATION_PAROLE_REVIEW
  // Hành chính
  ADMIN_RECONSIDERATION
  ADMIN_NON_LITIGATION_ENFORCEMENT
  // Ngoài tố tụng
  NON_LITIGATION_PHASE
  // Dự phòng (fallback)
  CUSTOM
}

enum ProcedureStatus {
  PENDING
  IN_PROGRESS
  CONCLUDED
}

enum ProcedureEngagement {
  ENGAGED
  INFORMATIONAL
}

enum ProcedureOutcome {
  WON
  PARTIAL_WON
  LOST
  MEDIATED
  WITHDRAWN
  DISMISSED
  COMPLETED
  TRANSFERRED
  OTHER
}

enum PartyRole {
  CLIENT_PARTY
  OPPOSING_PARTY
  THIRD_PARTY
  CO_LITIGANT
  AGENT
  WITNESS
  OTHER
}

// v0.27: Loại chủ thể tham gia (cá nhân cần số giấy tờ tùy thân; các chủ thể khác cần mã số thuế doanh nghiệp)
// v0.30: Chi tiết loại chủ thể (công ty / hợp doanh / hộ kinh doanh cá thể / đơn vị sự nghiệp / tổ chức xã hội / cơ quan nhà nước / tổ chức khác)
enum PartyType {
  NATURAL_PERSON
  ORGANIZATION // Tương thích dữ liệu cũ (= Tổ chức khác)
  COMPANY
  PARTNERSHIP
  INDIVIDUAL_BUSINESS
  INSTITUTION
  SOCIAL_ORG
  GOVERNMENT
  OTHER_ORG
}

// v0.30: Có cần khai báo với Đoàn Luật sư hay không
enum BarFilingType {
  NONE // Không
  COLLECTIVE // Vụ án tập thể
  SENSITIVE // Vụ án nhạy cảm
  MAJOR // Vụ án lớn
  OTHER // Vụ án đặc biệt khác
}

enum ClientType {
  INDIVIDUAL
  COMPANY
  ORGANIZATION
}

// v0.39: Trạng thái hợp tác với khách (vòng đời)
enum ClientCooperationStatus {
  POTENTIAL // Tiềm năng
  NEGOTIATING // Đang đàm phán
  SIGNED // Đã ký hợp đồng
  TERMINATED // Đã chấm dứt
}

// v0.39: Giới tính khách (khách lẻ)
enum ClientGender {
  MALE
  FEMALE
}

enum ConflictSeverity {
  LOW
  MEDIUM
  HIGH
  BLOCKING
}

enum ConflictConclusion {
  PENDING
  SAME_SUBJECT
  DIFFERENT
  NEED_INFO
}

enum DeadlineCategory {
  LIMITATION
  EVIDENCE
  APPEAL
  PERFORMANCE
  RESPONSE
  ENFORCEMENT
  ARBITRATION_SET_ASIDE
  // v0.42: Thời hạn bảo toàn (kể cả gia hạn)
  PRESERVATION
  CUSTOM
}

enum NoteChannel {
  PHONE
  WECHAT
  EMAIL
  MEETING
  COURT
  OTHER
}

enum DocumentCategory {
  EVIDENCE
  PLEADING
  PROCEDURE
  JUDGMENT
  CONTRACT
  OTHER
}

enum BillingStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum FeeEntryType {
  RECEIVABLE
  RECEIVED
  REFUND
  COST
  COMMISSION
}

// v0.8: Phân loại mẫu văn bản
enum TemplateCategory {
  INTAKE // Văn bản tiếp nhận vụ: bảng đăng ký tiếp nhận / thông báo rủi ro / phiếu phản hồi chất lượng
  RETAINER // Văn bản ủy quyền: hợp đồng ủy quyền đại diện / giấy ủy quyền
  LITIGATION // Văn bản tố tụng: đơn khởi kiện / bản biện hộ / đơn kháng cáo / đơn phản tố / đơn yêu cầu trọng tài
  HEARING // Văn bản phiên tòa: biên bản đối thoại / biên bản phiên tòa / biên bản nghiên cứu hồ sơ / biên bản hỏi cung
  WORK_PRODUCT // Kết quả công việc: bản tóm tắt xử lý vụ / ý kiến pháp lý / luận điểm đại diện / thư luật sư / công hàm
  ARCHIVE // Văn bản hồ sơ vụ: bìa hồ sơ / mục lục hồ sơ / bìa gáy / bảng kê chứng cứ
  CLOSING // Văn bản kết thúc: bảng đăng ký kết thúc vụ / phiếu quyết toán
  BLANK // Văn bản trắng (in theo đầu trang văn phòng luật)
}

// v0.8: Loại dấu
enum SealType {
  OFFICIAL_SEAL // Dấu tròn văn phòng luật
  CONTRACT_SEAL // Dấu hợp đồng
  FINANCE_SEAL // Dấu tài chính
  LEGAL_REP_SEAL // Dấu đại diện pháp luật
  CONTRACT_REVIEW_SEAL // Dấu duyệt hợp đồng
}

// v0.8: Trạng thái yêu cầu đóng dấu
enum SealRequestStatus {
  PENDING // Chờ duyệt
  APPROVED // Đã duyệt, chờ đóng dấu
  STAMPED // Đã đóng dấu và cập nhật bản scan (trạng thái cuối)
  REJECTED // Bị từ chối (trạng thái cuối, nhưng có thể tạo yêu cầu mới trỏ tới ID này để xin lại)
  CANCELLED // Người yêu cầu tự rút lại
}

// v0.8: Mức độ khẩn cấp
enum Urgency {
  NORMAL
  URGENT
}

// ============================================================
// Người dùng và phân quyền
// ============================================================

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(LAWYER)
  phone        String?
  avatar       String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?

  ownedMatters             Matter[]                      @relation("MatterOwner")
  createdWorkTasks         WorkTask[]                    @relation("CreatedBy")
  assignedWorkTasks        WorkTask[]                    @relation("AssignedTo")
  taskAssignmentsMade      TaskAssignment[]              @relation("AssignmentMade")
  taskAssignmentsReceived  TaskAssignment[]              @relation("AssignmentReceived")
  ownedProjects            Project[]                     @relation("ProjectOwner")
  managedProjects          Project[]                     @relation("ProjectManager")
  ownedWorkflows           Workflow[]                    @relation("WorkflowOwner")
  taskHistories            TaskHistory[]
  projectMemberships       ProjectMember[]
  assignedWorkflowSteps    WorkflowStep[]
  commentsAuthored         Comment[]
  checklistItemsAssigned   TaskChecklistItem[]
  watchedTasks             TaskWatcher[]
  teamMemberships          TeamMember[]
  memberships              MatterMember[]
  commissionPlans          CommissionPlan[]
  feeEntriesBeneficiary    FeeEntry[]                    @relation("FeeBeneficiary")
  feeEntriesRecorded       FeeEntry[]                    @relation("FeeRecorder")
  authoredNotes            Note[]                        @relation("NoteAuthor")
  uploadedDocuments        Document[]                    @relation("DocumentUploader")
  reviewedDocuments        Document[]                    @relation("DocumentReviewer")
  approvedDocuments        Document[]                    @relation("DocumentApprover")
  auditLogs                AuditLog[]
  taskCommentsAuthored     TaskComment[]                 @relation("CommentAuthor")
  conflictDecisions        ConflictCheck[]               @relation("ConflictDecidedBy")
  // v0.5
  ownedIntakes             Intake[]                      @relation("IntakeOwner")
  invoiceRequests          InvoiceRequest[]              @relation("InvoiceRequester")
  invoiceProcessing        InvoiceRequest[]              @relation("InvoiceProcessor")
  // v0.8: người tạo mẫu + người xin đóng dấu / duyệt / đóng dấu
  createdTemplates         DocumentTemplate[]            @relation("TemplateCreator")
  sealRequests             SealRequest[]                 @relation("SealRequester")
  sealApprovals            SealRequest[]                 @relation("SealApprover")
  sealStamps               SealRequest[]                 @relation("SealStamper")
  // v0.9: người nhận tin nhắn / người phụ trách bảo toàn / người thực hiện gia hạn bảo toàn / người tạo vận đơn
  receivedSmsMessages      SmsMessage[]                  @relation("SmsReceiver")
  ownedPreservations       Preservation[]                @relation("PreservationOwner")
  preservationRenewals     PreservationRenewal[]         @relation("RenewalPerformer")
  // v0.44: Tái cấu trúc bảo toàn 3 tầng
  ownedPreservationCases   PreservationCase[]            @relation("PreservationCaseOwner")
  propertyRenewals         PreservationPropertyRenewal[] @relation("PropertyRenewalPerformer")
  createdExpress           ExpressTracking[]             @relation("ExpressCreator")
  // v0.10: Thông báo
  notifications            Notification[]
  // v0.21: Lịch sử rà soát văn bản bằng AI (người khởi tạo)
  aiReviews                ReviewRecord[]                @relation("ReviewAuthor")
  // v0.22: Người tải lên tài liệu văn phòng
  firmFilesUploaded        FirmFile[]                    @relation("FirmFileUploader")
  // v0.27: Trung tâm dịch vụ - người đăng thông báo / người nhập liên hệ ngoài
  publishedAnnouncements   Announcement[]                @relation("AnnouncementAuthor")
  createdExternalContacts  ExternalContact[]             @relation("ExternalContactCreator")
  reviewedExternalContacts ExternalContact[]             @relation("ExternalContactReviewer")
  // v0.44: Luật sư chủ trì chương trình
  leadProcedures           MatterProcedure[]             @relation("ProcedureLeadLawyer")
  workflowAudits           WorkflowAudit[]               @relation("UserWorkflowAudits")
  uploadedFiles            File[]                        @relation("UserUploadedFiles")
  generatedReports         Report[]                      @relation("UserGeneratedReports")
  quotesOwned              Quote[]                       @relation("QuoteOwner")
  quotesCreated            Quote[]                       @relation("QuoteCreator")
  contractsOwned           Contract[]                    @relation("ContractOwner")
  contractsCreated         Contract[]                    @relation("ContractCreator")
  contractEvents           ContractEvent[]               @relation("ContractEventActor")
  timesheets               TimesheetEntry[]              @relation("TimesheetUser")
  timesheetsApproved       TimesheetEntry[]              @relation("TimesheetApprover")
  timesheetsCreated        TimesheetEntry[]              @relation("TimesheetCreator")
  expenseClaims            ExpenseClaim[]                @relation("ExpenseClaimant")
  expensesSubmitted        ExpenseClaim[]                @relation("ExpenseSubmitter")
  expensesApproved         ExpenseClaim[]                @relation("ExpenseApprover")
  leaveRequests            LeaveRequest[]                @relation("LeaveRequester")
  leaveApprovals           LeaveRequest[]                @relation("LeaveApprover")
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
}

// ============================================================
// Khách hàng và người liên hệ
// ============================================================

model Client {
  id                String                  @id @default(cuid())
  name              String
  type              ClientType
  idNumber          String?
  address           String?
  phone             String?
  email             String?
  source            String?
  tags              String[]
  notes             String?
  legalRep          String?
  // v0.39: Các trường bổ sung theo mô hình hồ sơ vụ án điện tử
  internalCode      String?                 @unique // Mã khách hàng KH-{YYYY}-{4 số}
  cooperationStatus ClientCooperationStatus @default(SIGNED) // Trạng thái hợp tác
  industry          String? // Ngành nghề
  gender            ClientGender? // Giới tính (khách lẻ)
  ethnicity         String? // Dân tộc (khách lẻ)
  contacts          Contact[]
  intakes           Intake[]
  matterLinks       MatterClient[]
  matters           Matter[]
  deletedAt         DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  quotes            Quote[]
  contracts         Contract[]

  @@index([name])
  @@index([idNumber])
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  title     String?
  phone     String?
  email     String?
  wechat    String?
  isPrimary Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quotes    Quote[]

  @@index([clientId])
}

// ============================================================
// Kho danh mục căn cứ khởi kiện (案由) chuẩn hóa
// ============================================================

model CauseOfAction {
  id         String          @id @default(cuid())
  category   MatterCategory
  code       String?
  name       String
  shortName  String?
  level      Int
  parentId   String?
  parent     CauseOfAction?  @relation("CauseHierarchy", fields: [parentId], references: [id])
  children   CauseOfAction[] @relation("CauseHierarchy")
  active     Boolean         @default(true)
  pinyin     String?
  keywords   String[]
  matters    Matter[]
  intakes    Intake[]
  sourceNote String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([category, code])
  @@index([category, level])
  @@index([category, active, level])
  @@index([name])
  @@index([parentId])
}

// ============================================================
// Tiếp nhận vụ án
// ============================================================

model Intake {
  id             String         @id @default(cuid())
  title          String
  category       MatterCategory @default(CIVIL_COMMERCIAL)
  causeId        String?
  cause          CauseOfAction? @relation(fields: [causeId], references: [id])
  causeFreeText  String?
  description    String?
  status         IntakeStatus   @default(INTAKE)
  receivedAt     DateTime       @default(now())
  declinedReason String?

  // v0.5: Khách hàng + người liên hệ
  clientId     String?
  client       Client?     @relation(fields: [clientId], references: [id])
  clientType   ClientType? // Dùng để tự động tạo hồ sơ khi gửi; sau khi chuyển đổi thì gắn theo bảng Client
  contactName  String?
  contactPhone String?

  // v0.5: Chương trình + tư cách tố tụng + cơ quan giải quyết tranh chấp + giá trị tranh chấp
  firstProcedureType ProcedureType?
  firstAgency        String? // Cơ quan giải quyết tranh chấp: tên của Tòa án / Trung tâm trọng tài / Cơ quan điều tra
  jurisdiction       String? // v0.30 Địa bàn: đường dẫn tỉnh / thành phố / quận huyện
  ourStanding        LitigationStanding?
  claimAmount        Decimal?            @db.Decimal(14, 2)
  claimDescription   String? // Mô tả giá trị tranh chấp phi tiền

  // v0.30: Khai báo Đoàn Luật sư + có phản tố không (loại tố tụng / trọng tài)
  barFiling    BarFilingType?
  counterclaim Boolean        @default(false)

  // v0.31: Trường riêng cho nhóm ngoài tố tụng / cố vấn / chuyên đề
  businessType String? // Loại hình (ngoài tố tụng / chuyên đề)
  serviceScope String? // Phạm vi / nội dung dịch vụ (ngoài tố tụng / chuyên đề / cố vấn)
  deliverables String? // Sản phẩm bàn giao (ngoài tố tụng / chuyên đề)
  counselType  String? // Loại cố vấn: thường trực / chuyên đề (cố vấn)
  serviceStart DateTime? // Bắt đầu / mở đầu hạn cố vấn
  serviceEnd   DateTime? // Kết thúc / kết thúc hạn cố vấn

  // v0.5: Phí luật sư
  feeType          FeeType?
  feeAmount        Decimal? @db.Decimal(14, 2) // FIXED: tổng số tiền; CONTINGENCY: phí xử lý cơ bản
  contingencyTerms String? // Diễn giải tự do cách tính phí đại diện theo rủi ro (chỉ dùng cho CONTINGENCY)
  feeSchedule      String? // Mốc thanh toán
  feeNote          String?

  // v0.5: Luật sư chủ trì + luật sư đồng (sinh MatterMember khi chuyển đổi)
  ownerUserId String?
  ownerUser   User?    @relation("IntakeOwner", fields: [ownerUserId], references: [id])
  coUserIds   String[] @default([])

  parties        Party[]
  conflictChecks ConflictCheck[]
  matter         Matter?
  documents      Document[]

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quotes      Quote[]

  @@index([status, receivedAt])
  @@index([causeId])
  @@index([ownerUserId])
}

// ============================================================
// Vụ án (Matter) + thành viên nhóm + nhiều khách hàng
// ============================================================

model Matter {
  id           String         @id @default(cuid())
  internalCode String         @unique
  firmCaseNo   String?        @unique // v0.42 Số hiệu vụ trong văn phòng (sinh theo mẫu cấu hình được)
  title        String
  category     MatterCategory @default(CIVIL_COMMERCIAL)
  status       MatterStatus   @default(IN_PROGRESS)

  causeId       String?
  cause         CauseOfAction? @relation(fields: [causeId], references: [id])
  causeFreeText String?

  claimAmount Decimal? @db.Decimal(14, 2)

  ourStanding             LitigationStanding?
  counterclaimAsPlaintiff Boolean             @default(false)
  counterclaimAsDefendant Boolean             @default(false)
  barFiling               BarFilingType? // v0.35 Có cần khai báo Đoàn Luật sư không (loại tố tụng / trọng tài)

  // v0.35: Riêng ngoài tố tụng / cố vấn / chuyên đề (mang theo khi chuyển từ Intake)
  businessType String? // Loại hình (ngoài tố tụng / chuyên đề)
  serviceScope String? // Phạm vi / nội dung dịch vụ
  deliverables String? // Sản phẩm bàn giao (ngoài tố tụng / chuyên đề)
  counselType  String? // Loại cố vấn (cố vấn)
  serviceStart DateTime? // Bắt đầu / mở đầu hạn cố vấn
  serviceEnd   DateTime? // Kết thúc / kết thúc hạn cố vấn

  intakeDate DateTime?

  primaryClientId String?
  primaryClient   Client?        @relation(fields: [primaryClientId], references: [id])
  clientLinks     MatterClient[]

  ownerId String
  owner   User           @relation("MatterOwner", fields: [ownerId], references: [id])
  members MatterMember[]

  intakeId String? @unique
  intake   Intake? @relation(fields: [intakeId], references: [id])

  firstAcceptedAt DateTime?
  closedAt        DateTime?
  archivedAt      DateTime?

  procedures        MatterProcedure[]
  parties           Party[]
  relatedEntities   RelatedEntity[]
  linksFrom         MatterLink[]       @relation("MatterLinkFrom") // v0.32 Vụ án liên quan (vụ này → vụ liên quan)
  linksTo           MatterLink[]       @relation("MatterLinkTo") // Chiều ngược (vụ liên quan → vụ này)
  notes             Note[]
  tasks             LegalTask[]
  documents         Document[]
  timelineEvents    TimelineEvent[]
  billings          Billing[]
  feeEntries        FeeEntry[]
  commissionPlans   CommissionPlan[]
  archiveRecords    ArchiveRecord[]
  invoiceRequests   InvoiceRequest[]
  // v0.8: Hồ sơ vụ + đóng dấu
  folders           DocumentFolder[]
  sealRequests      SealRequest[]
  // v0.9: Tin nhắn tòa án + bảo toàn tài sản + theo dõi chuyển phát
  smsMessages       SmsMessage[]
  preservations     Preservation[]
  preservationCases PreservationCase[]
  expressTrackings  ExpressTracking[]
  // v0.21: Lịch sử rà soát văn bản bằng AI
  reviewRecords     ReviewRecord[]

  // v0.28: Giá trị trường tùy chỉnh { [CustomFieldDef.key]: string }
  customValues Json @default("{}")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, updatedAt])
  @@index([ownerId])
  @@index([primaryClientId])
  @@index([category, status])
  @@index([causeId])
  quotes         Quote[]
  contracts      Contract[]
  timesheets     TimesheetEntry[]
  expenseClaims  ExpenseClaim[]
}

// v0.28: Trường tùy chỉnh (giải pháp cột JSON). Định nghĩa trường lưu ở bảng, giá trị lưu ở customValues JSON của thực thể.
enum CustomFieldEntity {
  MATTER
  CLIENT
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

model CustomFieldDef {
  id         String            @id @default(cuid())
  entityType CustomFieldEntity
  key        String // Khoá ổn định, là tên thuộc tính ghi vào customValues của thực thể
  label      String
  fieldType  CustomFieldType   @default(TEXT)
  options    String[] // Giá trị chọn được của loại SELECT
  required   Boolean           @default(false)
  order      Int               @default(0)
  enabled    Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([entityType, key])
  @@index([entityType, order])
}

model MatterMember {
  matterId String
  matter   Matter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id])
  role     MatterMemberRole @default(ASSISTANT)
  joinedAt DateTime         @default(now())

  @@id([matterId, userId])
  @@index([userId])
}

model MatterClient {
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  label     String?
  isPrimary Boolean  @default(false)
  addedAt   DateTime @default(now())

  @@id([matterId, clientId])
  @@index([clientId])
}

// ============================================================
// Giai đoạn chương trình
// ============================================================

model MatterProcedure {
  id       String @id @default(cuid())
  matterId String
  matter   Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  type        ProcedureType
  customLabel String?
  engagement  ProcedureEngagement @default(ENGAGED)
  order       Int

  caseNumber     String?
  handlingAgency String? // Cơ quan giải quyết (Tòa án / Hội đồng trọng tài / Tòa án thi hành án…)
  panel          String?
  handler        String?

  // v0.32: Thông tin bổ sung cấp chương trình
  jurisdiction          String? // Địa bàn (tỉnh / thành phố / quận huyện)
  presidingJudge        String? // Thẩm phán chủ trì / Trọng tài viên chính / Thẩm phán thi hành án
  presidingJudgeContact String? // Thông tin liên hệ thẩm phán chủ trì
  judgeAssistant        String? // Trợ lý thẩm phán / Trợ lý Hội đồng trọng tài
  judgeAssistantContact String? // Thông tin liên hệ trợ lý
  ourStanding           LitigationStanding? // Tư cách phía ta (các lựa chọn tùy theo chương trình)

  // v0.44: Luật sư chủ trì
  leadLawyerId   String? // Luật sư chủ trì (luật sư trong văn phòng)
  leadLawyer     User?   @relation("ProcedureLeadLawyer", fields: [leadLawyerId], references: [id], onDelete: SetNull)
  isExternalLead Boolean @default(false) // Có phải đại diện ngoài văn phòng không

  acceptedAt  DateTime? // Thời điểm thụ lý
  concludedAt DateTime? // Thời điểm phán quyết / kết thúc vụ

  status      ProcedureStatus   @default(PENDING)
  outcome     ProcedureOutcome?
  outcomeNote String?

  stages           MatterStage[]
  hearings         Hearing[]
  deadlines        Deadline[]
  documents        Document[]
  procedureParties ProcedureParty[]
  // v0.42: Ghi chú chương trình (cần làm / đã làm)
  memos            ProcedureMemo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matterId, order])
  @@index([matterId, order])
  @@index([status])
}

model MatterStage {
  id          String          @id @default(cuid())
  procedureId String
  procedure   MatterProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int
  startedAt   DateTime?
  completedAt DateTime?
  tasks       LegalTask[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([procedureId, order])
}

// ============================================================
// Nhiệm vụ / Mở phiên tòa / Thời hạn
// ============================================================

model LegalTask {
  id          String       @id @default(cuid())
  matterId    String
  matter      Matter       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  stageId     String?
  stage       MatterStage? @relation(fields: [stageId], references: [id])
  title       String
  description String?
  assigneeId  String?
  dueAt       DateTime?
  completed   Boolean      @default(false)
  completedAt DateTime?
  priority    Int          @default(0)
  teamId      String?
  team        Team?        @relation("TeamTasks", fields: [teamId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([matterId, completed, dueAt])
  @@index([assigneeId, completed])
  @@index([teamId])
  timesheets TimesheetEntry[]
}

model Hearing {
  id          String          @id @default(cuid())
  procedureId String
  procedure   MatterProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  title       String
  room        String?
  address     String?
  judge       String?
  contact     String?
  startsAt    DateTime
  endsAt      DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([procedureId, startsAt])
  @@index([startsAt])
}

model Deadline {
  id          String           @id @default(cuid())
  procedureId String
  procedure   MatterProcedure  @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  title       String
  category    DeadlineCategory @default(CUSTOM)
  dueAt       DateTime
  basis       String?
  remindDays  Int              @default(3)
  completed   Boolean          @default(false)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([procedureId, dueAt, completed])
  @@index([dueAt, completed])
}

// v0.42: Ghi chú chương trình (đặt cạnh các mốc thời hạn quan trọng, trạng thái cần làm / đã làm)
model ProcedureMemo {
  id          String          @id @default(cuid())
  procedureId String
  procedure   MatterProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  content     String
  done        Boolean         @default(false)
  doneAt      DateTime?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([procedureId])
}

// ============================================================
// Chủ thể tham gia / Thực thể liên quan
// ============================================================

model Party {
  id                   String              @id @default(cuid())
  intakeId             String?
  intake               Intake?             @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  matterId             String?
  matter               Matter?             @relation(fields: [matterId], references: [id], onDelete: Cascade)
  role                 PartyRole
  // v0.5: Tư cách tố tụng cụ thể (liên kết theo chương trình đầu tiên); role giữ lại làm mức thô
  standing             LitigationStanding?
  ordinal              Int                 @default(1)
  name                 String
  // v0.27: Loại chủ thể quyết định nhánh trường bắt buộc (cá nhân → idNumber; công ty → enterpriseSocialCode + legalRep + address)
  partyType            PartyType           @default(NATURAL_PERSON)
  idNumber             String?
  phone                String?
  address              String?
  legalRep             String?
  // v0.27: Người liên hệ phụ trách (khác với phone là điện thoại của chính chủ thể, thường dùng cho nhánh công ty)
  contactName          String?
  notes                String?
  // v0.26: Tra cứu rủi ro công ty đối phương — sau khi liên kết doanh nghiệp 元典 (Yuandian) có thể tải tổng quan rủi ro một chạy
  enterpriseId         String?
  enterpriseSocialCode String?
  enterpriseName       String?
  enterpriseBoundAt    DateTime?
  procedureParties     ProcedureParty[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([matterId, role, ordinal])
  @@index([name])
  @@index([idNumber])
  @@index([enterpriseSocialCode])
}

model ProcedureParty {
  id          String             @id @default(cuid())
  procedureId String
  procedure   MatterProcedure    @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  partyId     String
  party       Party              @relation(fields: [partyId], references: [id], onDelete: Cascade)
  standing    LitigationStanding
  ordinal     Int                @default(1)
  note        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([procedureId, partyId, standing])
  @@index([procedureId, standing, ordinal])
  @@index([partyId])
  @@map("procedure_parties")
}

model RelatedEntity {
  id           String   @id @default(cuid())
  matterId     String
  matter       Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
}

// v0.32: Vụ án liên quan (vụ ↔ vụ, ghi có hướng, hiển thị gộp cả hai chiều)
model MatterLink {
  id              String   @id @default(cuid())
  matterId        String
  matter          Matter   @relation("MatterLinkFrom", fields: [matterId], references: [id], onDelete: Cascade)
  relatedMatterId String
  relatedMatter   Matter   @relation("MatterLinkTo", fields: [relatedMatterId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([matterId, relatedMatterId])
  @@index([matterId])
  @@index([relatedMatterId])
}

// ============================================================
// Tra cứu xung đột lợi ích
// ============================================================

model ConflictCheck {
  id           String             @id @default(cuid())
  intakeId     String?
  intake       Intake?            @relation(fields: [intakeId], references: [id])
  queryPayload Json
  hits         ConflictHit[]
  conclusion   ConflictConclusion @default(PENDING)
  decidedById  String?
  decidedBy    User?              @relation("ConflictDecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  note         String?
  checkedAt    DateTime           @default(now())
}

model ConflictHit {
  id           String           @id @default(cuid())
  checkId      String
  check        ConflictCheck    @relation(fields: [checkId], references: [id], onDelete: Cascade)
  hitType      String
  targetType   String
  targetId     String
  matchedName  String
  matchedField String
  matchedValue String
  matchedRatio Float?
  severity     ConflictSeverity
  reason       String
}

// ============================================================
// Lịch sử trao đổi
// ============================================================

model Note {
  id          String      @id @default(cuid())
  matterId    String
  matter      Matter      @relation(fields: [matterId], references: [id], onDelete: Cascade)
  authorId    String
  author      User        @relation("NoteAuthor", fields: [authorId], references: [id])
  channel     NoteChannel @default(OTHER)
  withWhom    String?
  occurredAt  DateTime    @default(now())
  content     String
  tags        String[]
  attachments String[]
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([matterId, occurredAt])
}

// ============================================================
// Tài liệu (hỗ trợ mã hóa)
// ============================================================

model Document {
  id           String           @id @default(cuid())
  // v0.4: matterId có thể null (giai đoạn tiếp nhận gắn trên Intake); khi chuyển sang Matter thì điền lại
  matterId     String?
  matter       Matter?          @relation(fields: [matterId], references: [id], onDelete: Cascade)
  intakeId     String?
  intake       Intake?          @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  procedureId  String?
  procedure    MatterProcedure? @relation(fields: [procedureId], references: [id])
  name         String
  category     DocumentCategory @default(OTHER)
  // v0.42: Bên cung cấp tài liệu (phía ta / đối phương / người thứ ba…, lấy từ chủ thể của vụ, có thể null)
  sourceParty  String?
  // v0.10: Quy trình duyệt văn bản
  status       DocumentStatus   @default(DRAFT)
  reviewedById String?
  reviewedBy   User?            @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  approvedById String?
  approvedBy   User?            @relation("DocumentApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  version      Int              @default(1)
  isLatest     Boolean          @default(true)
  familyId     String?

  path     String
  mimeType String?
  size     Int?
  sha256   String?

  encrypted Boolean @default(false)
  algorithm String?
  iv        String?
  authTag   String?

  tags         String[]
  uploadedById String
  uploadedBy   User      @relation("DocumentUploader", fields: [uploadedById], references: [id])
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // v0.5: Ngược lại - tệp đính kèm của quy trình hóa đơn
  invoiceAsContract InvoiceRequest? @relation("InvoiceContractScan")
  invoiceAsFile     InvoiceRequest? @relation("InvoiceFile")

  // v0.8: Thuộc hồ sơ vụ + sinh từ mẫu
  folderId                String?
  folder                  DocumentFolder?   @relation(fields: [folderId], references: [id])
  templateId              String?
  template                DocumentTemplate? @relation("TemplateGenerated", fields: [templateId], references: [id])
  templateContextSnapshot Json?
  // v0.8: Ngược lại - là file docx nguồn của một mẫu
  templateBlobOf          DocumentTemplate? @relation("TemplateBlob")
  // v0.8: Ngược lại - bản nháp chờ đóng dấu / bản scan sau khi đóng dấu của yêu cầu đóng dấu
  sealAsDraft             SealRequest?      @relation("SealDraft")
  sealAsStamped           SealRequest?      @relation("SealStamped")

  // v0.17: Liên kết danh mục lưu trữ — khi tải lên thì bind với ArchiveChecklistItem.id (id dạng chuỗi trong lib/archive/checklists.ts),
  // dùng để trình hướng dẫn lưu trữ tự động tích các hạng mục bắt buộc đã tải lên. Một tài liệu chỉ bind được một checklist item.
  archiveChecklistItemId String?

  // v0.21: Ngược lại - lịch sử rà soát AI
  reviewRecords ReviewRecord[]

  @@index([matterId, category])
  @@index([intakeId])
  @@index([procedureId])
  @@index([familyId])
  @@index([folderId])
  @@index([templateId])
  @@index([matterId, archiveChecklistItemId])
  contracts Contract[] @relation("ContractDocument")
  expenseReceipts ExpenseClaim[] @relation("ExpenseReceipt")
}

// ============================================================
// Quy trình xin xuất hóa đơn (v0.5)
// Luật sư gửi yêu cầu ở chi tiết vụ án → Tài chính duyệt → tải lên hợp đồng bản scan + hóa đơn điện tử
// ============================================================

model InvoiceRequest {
  id             String               @id @default(cuid())
  // v0.43 mục 5: matterId có thể null — hỗ trợ xuất hóa đơn "không liên kết vụ án" (bắt buộc điền noMatterReason)
  matterId       String?
  matter         Matter?              @relation(fields: [matterId], references: [id], onDelete: Cascade)
  noMatterReason String? // Giải thích lý do khi không liên kết vụ án (bắt buộc khi matterId null)
  amount         Decimal              @db.Decimal(14, 2)
  title          String? // Ghi chú / cách xưng hô với khách (chỉ để tương thích; trường mới dùng buyerName)
  status         InvoiceRequestStatus @default(PENDING)
  requestNote    String?

  // v0.12: Loại hóa đơn + danh mục + tên đơn vị mua + mã số thuế + căn cứ xuất hóa đơn
  invoiceType      InvoiceType?
  invoiceItem      InvoiceItem?
  buyerName        String? // Tên đơn vị mua (tên khách, sửa được)
  buyerTaxNo       String? // Mã số thuế khách (bắt buộc với hóa đơn đặc biệt)
  // v0.42: Bổ sung "6 yếu tố" bên mua của hóa đơn GTGT đặc biệt (theo luật thuế: ngân hàng mở tài khoản, số tài khoản, địa chỉ, điện thoại là bắt buộc)
  buyerAddress     String? // Địa chỉ bên mua (bắt buộc hóa đơn đặc biệt)
  buyerPhone       String? // Điện thoại bên mua (bắt buộc hóa đơn đặc biệt)
  buyerBank        String? // Ngân hàng mở tài khoản bên mua (bắt buộc hóa đơn đặc biệt)
  buyerBankAccount String? // Số tài khoản ngân hàng bên mua (bắt buộc hóa đơn đặc biệt)
  evidenceDocIds   String[]     @default([]) // Danh sách Document id làm căn cứ xuất hóa đơn

  // v0.14: Số hóa đơn thực (điền lại khi Tài chính xuất xong)
  invoiceNo String?
  issuedAt  DateTime?

  requestedById String
  requestedBy   User     @relation("InvoiceRequester", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())

  processedById String?
  processedBy   User?     @relation("InvoiceProcessor", fields: [processedById], references: [id])
  processedAt   DateTime?
  processNote   String?

  // Tài chính tải lên: hợp đồng bản scan + tệp hóa đơn điện tử (đều qua Document)
  contractScanId String?   @unique
  contractScan   Document? @relation("InvoiceContractScan", fields: [contractScanId], references: [id])
  invoiceFileId  String?   @unique
  invoiceFile    Document? @relation("InvoiceFile", fields: [invoiceFileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matterId, status])
  @@index([status, requestedAt])
  @@index([requestedById])
}

// ============================================================
// Tài chính: Hợp đồng / Thu chi / Chia hoa hồng
// ============================================================

model Billing {
  id             String        @id @default(cuid())
  matterId       String
  matter         Matter        @relation(fields: [matterId], references: [id], onDelete: Cascade)
  title          String
  contractAmount Decimal       @db.Decimal(14, 2)
  schedule       String?
  status         BillingStatus @default(DRAFT)
  signedAt       DateTime?
  feeEntries     FeeEntry[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([matterId, status])
}

model FeeEntry {
  id           String       @id @default(cuid())
  matterId     String
  matter       Matter       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  billingId    String?
  billing      Billing?     @relation(fields: [billingId], references: [id])
  type         FeeEntryType
  amount       Decimal      @db.Decimal(14, 2)
  occurredAt   DateTime     @default(now())
  invoiceNo    String?
  invoiceFile  String?
  payerOrPayee String?
  method       String?
  note         String?

  accountId String?
  account   CashAccount? @relation(fields: [accountId], references: [id])

  parentFeeEntryId   String?
  parentFeeEntry     FeeEntry?  @relation("CommissionParent", fields: [parentFeeEntryId], references: [id])
  commissionChildren FeeEntry[] @relation("CommissionParent")

  beneficiaryUserId String?
  beneficiaryUser   User?   @relation("FeeBeneficiary", fields: [beneficiaryUserId], references: [id])

  recordedById String
  recordedBy   User   @relation("FeeRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matterId, type, occurredAt])
  @@index([type, occurredAt])
  @@index([beneficiaryUserId, occurredAt])
  @@index([accountId, occurredAt])
}

model CommissionPlan {
  id        String   @id @default(cuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  percent   Decimal  @db.Decimal(5, 2)
  label     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matterId, userId])
  @@index([matterId])
  @@index([userId])
}

// ============================================================
// Dòng thời gian / Lưu trữ / Kiểm toán
// ============================================================

model TimelineEvent {
  id         String   @id @default(cuid())
  matterId   String
  matter     Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  eventType  String
  title      String
  content    String?
  occurredAt DateTime
  refType    String?
  refId      String?
  createdAt  DateTime @default(now())

  @@index([matterId, occurredAt])
}

enum ArchiveStatus {
  PENDING_REVIEW // Yêu cầu lưu trữ đã gửi, chờ quản trị duyệt
  APPROVED // Đã duyệt, chính thức lưu trữ
  REJECTED // Quản trị từ chối
}

model ArchiveRecord {
  id       String @id @default(cuid())
  matterId String
  matter   Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  archiveNo       String               @unique
  summary         String
  judgmentSummary String?
  closedReason    ArchiveClosedReason?
  completedAt     DateTime?
  checklistJson   Json
  missingItems    String[]

  coverDocId   String?
  catalogDocId String?

  archivedBy   String // Ảnh chụp tên người yêu cầu (tương thích lịch sử, không xóa)
  archivedById String? // v0.18: User.id người yêu cầu, dùng để định tuyến thông báo duyệt
  archivedAt   DateTime @default(now())
  exportPath   String?
  checksum     String?

  // v0.16: Quy trình duyệt lưu trữ
  status       ArchiveStatus @default(PENDING_REVIEW)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  @@index([matterId])
  @@index([archivedAt])
  @@index([status])
  @@index([archivedById, status])
}

enum ArchiveClosedReason {
  JUDGMENT
  MEDIATION
  WITHDRAWAL
  SETTLEMENT
  RULING
  OTHER
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  targetType String?
  targetId   String?
  detail     Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model File {
  id           String   @id @default(cuid())
  name         String
  originalName String
  mimeType     String
  size         Int
  path         String
  url          String?
  entityType   String?
  entityId     String?
  uploadedById String
  uploadedAt   DateTime @default(now())

  uploadedBy User @relation("UserUploadedFiles", fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([uploadedAt])
}

model Report {
  id          String   @id @default(cuid())
  name        String
  type        String
  config      Json?
  generatedBy String
  createdAt   DateTime @default(now())
  fileUrl     String?

  generatedByUser User @relation("UserGeneratedReports", fields: [generatedBy], references: [id])

  @@index([type])
  @@index([generatedBy])
  @@index([createdAt])
}

// ============================================================
// Cấu hình hệ thống
// ============================================================

model StageTemplate {
  id            String        @id @default(cuid())
  procedureType ProcedureType
  isDefault     Boolean       @default(true)
  name          String
  steps         Json
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([procedureType])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ============================================================
// v0.8: Hệ thống mẫu văn bản
// ============================================================

// Định nghĩa mẫu (cấp hệ thống / văn phòng; không thuộc Matter cụ thể)
model DocumentTemplate {
  id                   String           @id @default(cuid())
  name                 String
  category             TemplateCategory
  description          String?
  applicableCategories MatterCategory[] // Mảng rỗng = áp dụng cho mọi loại vụ án
  docxBlobId           String           @unique
  docxBlob             Document         @relation("TemplateBlob", fields: [docxBlobId], references: [id])
  variables            Json // Danh sách biến ["client.name", "matter.caseNumber", ...] dùng để cảnh báo thiếu
  isBuiltIn            Boolean          @default(false) // Tích hợp sẵn của hệ thống, không xóa được
  enabled              Boolean          @default(true)
  createdById          String?
  createdBy            User?            @relation("TemplateCreator", fields: [createdById], references: [id])
  generatedDocs        Document[]       @relation("TemplateGenerated")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([category, enabled])
  @@index([isBuiltIn])
}

// Hồ sơ vụ (thư mục lưu trữ vật lý trong mỗi Matter)
model DocumentFolder {
  id         String     @id @default(cuid())
  matterId   String
  matter     Matter     @relation(fields: [matterId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int        @default(0)
  isDefault  Boolean    @default(false) // Hệ thống đặt sẵn theo loại vụ án (đổi tên được, không xóa được)
  documents  Document[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([matterId, name])
  @@index([matterId, orderIndex])
}

// ============================================================
// v0.8: Quy trình duyệt đóng dấu
// ============================================================

// Cấu hình loại dấu (quyết định §12.9.2: approverRoles: Role[] nhiều vai trò, quan hệ OR)
model SealTypeConfig {
  type             SealType   @id
  label            String // Tên hiển thị
  description      String?
  approverRoles    UserRole[] // Nhiều vai trò, quan hệ OR; mảng rỗng = chỉ requiresLegalRep có hiệu lực
  requiresLegalRep Boolean    @default(false) // Bắt buộc đại diện pháp luật tự duyệt (lấy SystemSetting key=firmLegalRepUserId)
  enabled          Boolean    @default(true)
  updatedAt        DateTime   @updatedAt
}

// Yêu cầu đóng dấu
model SealRequest {
  id       String   @id @default(cuid())
  code     String   @unique // SEAL-2026-0001
  sealType SealType
  matterId String?
  matter   Matter?  @relation(fields: [matterId], references: [id])

  purpose              String // Lý do đóng dấu
  documentTitle        String // Tiêu đề văn bản chờ đóng dấu
  pageCount            Int     @default(1)
  requireCrossPageSeal Boolean @default(false)
  copies               Int     @default(1)
  urgency              Urgency @default(NORMAL)

  // Bản nháp chờ đóng dấu (bắt buộc) + bản scan sau khi đóng dấu (bắt buộc bổ sung khi đóng xong)
  draftDocId   String    @unique
  draftDoc     Document  @relation("SealDraft", fields: [draftDocId], references: [id])
  stampedDocId String?   @unique
  stampedDoc   Document? @relation("SealStamped", fields: [stampedDocId], references: [id])

  status      SealRequestStatus @default(PENDING)
  requestNote String?
  approveNote String?

  requestedById String
  requestedBy   User     @relation("SealRequester", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())

  approvedById String?
  approvedBy   User?     @relation("SealApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  stampedById   String?
  stampedByUser User?     @relation("SealStamper", fields: [stampedById], references: [id])
  stampedAt     DateTime?

  rejectedAt DateTime?

  // Chuỗi truy vết khi tạo lại yêu cầu sau khi bị từ chối (cũ → mới)
  parentSealRequestId String?
  parentSealRequest   SealRequest?  @relation("SealResubmission", fields: [parentSealRequestId], references: [id])
  resubmissions       SealRequest[] @relation("SealResubmission")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, requestedAt])
  @@index([requestedById, status])
  @@index([sealType, status])
  @@index([matterId])
}

// ============================================================
// v0.9: Hộp thư tin nhắn tòa án
// ============================================================

// Loại tin nhắn (khớp với SMS_TYPE_KEYWORDS của hệ thống cũ)
enum SmsType {
  HEARING_NOTICE // Thông báo mở phiên tòa
  SERVICE_NOTICE // Thông báo tống đạt
  FEE_NOTICE // Thông báo nộp án phí / lệ phí
  MEDIATION // Thông báo hòa giải
  ENFORCEMENT // Thông báo thi hành án
  FILING_NOTICE // Thông báo thụ lý
  JUDGMENT_NOTICE // Thông báo bản án
  EVIDENCE_SUBMIT // Nộp tài liệu / trình chứng cứ
  OTHER
}

// Nguồn khớp với Matter
enum SmsMatchSource {
  AUTO_CASE_NUMBER // Tự khớp theo số hiệu vụ án
  MANUAL // Người dùng gán thủ công
  UNMATCHED
}

model SmsMessage {
  id           String   @id @default(cuid())
  rawText      String // Toàn văn tin nhắn gốc
  receivedAt   DateTime @default(now())
  receivedById String
  receivedBy   User     @relation("SmsReceiver", fields: [receivedById], references: [id], onDelete: Restrict)

  // Kết quả phân tích (gồm caseNumbers / court / hearingDate / urls / judge / clerk / phones...)
  parsedJson Json
  smsType    SmsType @default(OTHER)

  // Khớp liên quan
  matchedMatterId String?
  matchedMatter   Matter?        @relation(fields: [matchedMatterId], references: [id], onDelete: SetNull)
  matchedBy       SmsMatchSource @default(UNMATCHED)

  // id sản phẩm sinh ra từ thao tác một chạy (để truy vết)
  generatedHearingId  String?
  generatedDeadlineId String?

  processed   Boolean   @default(false)
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receivedById, processed, receivedAt])
  @@index([matchedMatterId])
  @@index([smsType, receivedAt])
}

// ============================================================
// v0.9: Bảo toàn tài sản
// ============================================================

enum PreservationType {
  PRE_LITIGATION // Bảo toàn trước khi kiện
  LITIGATION // Bảo toàn trong quá trình kiện
  ENFORCEMENT // Bảo toàn phục vụ thi hành án
}

enum PropertyType {
  BANK_DEPOSIT // Tiền gửi ngân hàng
  REAL_ESTATE // Bất động sản
  VEHICLE // Phương tiện giao thông
  EQUITY // Cổ phần / vốn góp
  IP // Sở hữu trí tuệ
  OTHER // Tài sản khác
}

enum GuaranteeType {
  CASH_DEPOSIT // Tiền ký quỹ
  GUARANTEE_LETTER // Thư bảo lãnh
  PROPERTY // Đảm bảo bằng tài sản
  NONE // Không cần đảm bảo
}

enum PreservationStatus {
  ACTIVE // Đang hiệu lực
  RENEWED // Đã gia hạn bảo toàn
  EXPIRED // Đã hết hạn
  LIFTED // Đã giải tỏa
}

model Preservation {
  id       String  @id @default(cuid())
  // Bảo toàn trước khi kiện có thể null (quyết định §13.8.3); sau khi thụ lý thì điền lại matterId
  matterId String?
  matter   Matter? @relation(fields: [matterId], references: [id], onDelete: SetNull)

  type          PreservationType
  propertyType  PropertyType
  amount        Decimal?         @db.Decimal(18, 2)
  respondent    String // Người bị bảo toàn
  guaranteeType GuaranteeType?

  appliedAt  DateTime? // Ngày nộp đơn
  startDate  DateTime // Ngày có hiệu lực (bắt buộc)
  duration   Int // Thời hạn bảo toàn (ngày); mặc định gợi ý theo propertyType
  expiryDate DateTime // Ngày hết hạn = startDate + duration (ghi đè thủ công được)

  court          String?
  rulingNumber   String?
  propertyDetail String?
  note           String?

  ownerId String?
  owner   User?   @relation("PreservationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Ngưỡng nhắc nhở (ngày) mặc định [30, 15, 7, 3, 1]
  remindDays Int[]                 @default([30, 15, 7, 3, 1])
  status     PreservationStatus    @default(ACTIVE)
  renewals   PreservationRenewal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matterId])
  @@index([status, expiryDate])
  @@index([ownerId, status])
}

model PreservationRenewal {
  id             String       @id @default(cuid())
  preservationId String
  preservation   Preservation @relation(fields: [preservationId], references: [id], onDelete: Cascade)

  renewedAt       DateTime
  oldExpiryDate   DateTime
  newExpiryDate   DateTime
  renewalDuration Int // Số ngày thêm vào
  note            String?

  performedById String
  performedBy   User     @relation("RenewalPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())

  @@index([preservationId])
}

// ============================================================
// v0.44: Tái cấu trúc bảo toàn 3 tầng (vụ án → người bị bảo toàn → tài sản)
// ============================================================

model PreservationCase {
  id       String  @id @default(cuid())
  matterId String?
  matter   Matter? @relation(fields: [matterId], references: [id], onDelete: SetNull)

  type          PreservationType
  status        PreservationStatus @default(ACTIVE)
  court         String?
  rulingNumber  String?
  guaranteeType GuaranteeType?
  appliedAt     DateTime?
  note          String?

  ownerId String?
  owner   User?   @relation("PreservationCaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  remindDays Int[] @default([30, 15, 7, 3, 1])

  targets   PreservationTarget[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([matterId])
  @@index([status])
}

model PreservationTarget {
  id     String           @id @default(cuid())
  caseId String
  case   PreservationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  name String // Tên người bị bảo toàn
  note String?

  properties PreservationProperty[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([caseId])
}

model PreservationProperty {
  id       String             @id @default(cuid())
  targetId String
  target   PreservationTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  propertyType   PropertyType
  propertyDetail String?
  amount         Decimal?           @db.Decimal(18, 2)
  startDate      DateTime
  duration       Int
  expiryDate     DateTime
  status         PreservationStatus @default(ACTIVE)

  renewals  PreservationPropertyRenewal[]
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt

  @@index([targetId])
  @@index([status, expiryDate])
}

model PreservationPropertyRenewal {
  id         String               @id @default(cuid())
  propertyId String
  property   PreservationProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  renewedAt       DateTime
  oldExpiryDate   DateTime
  newExpiryDate   DateTime
  renewalDuration Int
  note            String?

  performedById String
  performedBy   User     @relation("PropertyRenewalPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())

  @@index([propertyId])
}

// ============================================================
// v0.9.3: Theo dõi chuyển phát
// ============================================================

enum ExpressDirection {
  OUTBOUND // Gửi đi (văn phòng → tòa án / đương sự / đối phương)
  INBOUND // Nhận vào (tòa án / đương sự → văn phòng)
}

model ExpressTracking {
  id             String           @id @default(cuid())
  matterId       String?
  matter         Matter?          @relation(fields: [matterId], references: [id], onDelete: SetNull)
  trackingNo     String
  companyCode    String? // Tên hãng (Shunfeng / Zhongtong…)
  direction      ExpressDirection
  purpose        String // Mục đích (vd: gửi đơn khởi kiện tới Tòa án Chaoyang / tòa án tống đạt bản án)
  recipient      String? // Người nhận / đơn vị
  recipientPhone String?

  lastState    String? // Đã nhận hàng / đang vận chuyển / đến nơi đi phát / đã ký nhận / trả lại / vướng mắc
  lastUpdateAt DateTime?
  tracesJson   Json? // Ảnh chụp toàn bộ lộ trình (lần làm mới sau ghi đè lần trước; không lưu vào lịch sử)

  createdById String
  createdBy   User     @relation("ExpressCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([matterId])
  @@index([trackingNo])
  @@index([createdById, createdAt])
}

// ============================================================
// v0.10: Hệ thống thông báo
// ============================================================

enum NotificationType {
  PRESERVATION_EXPIRY
  HEARING_REMINDER
  DEADLINE_REMINDER
  SEAL_STATUS_CHANGE
  SMS_ARRIVAL
  TASK_ASSIGNED
  SYSTEM
  // v0.18: Thông báo duyệt lưu trữ
  ARCHIVE_APPROVED
  ARCHIVE_REJECTED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  priority  NotificationPriority @default(NORMAL)
  title     String
  content   String?
  href      String?
  refType   String?
  refId     String?
  read      Boolean              @default(false)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

// v0.21: Lịch sử rà soát văn bản bằng AI
// Mỗi lần bấm "Rà soát AI" và có kết quả sẽ ghi một bản ghi; tra ngược theo document/matter sẽ lấy được toàn bộ lịch sử
model ReviewRecord {
  id           String   @id @default(cuid())
  matterId     String
  matter       Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewedById String
  reviewedBy   User     @relation("ReviewAuthor", fields: [reviewedById], references: [id])
  reviewedAt   DateTime @default(now())

  itemCount        Int
  itemsJson        Json // ReviewItem[]
  textPreviewChars Int
  truncated        Boolean @default(false)

  @@index([documentId, reviewedAt])
  @@index([matterId, reviewedAt])
}

// v0.22: Kho tài liệu cấp văn phòng (không gắn với vụ án)
// Quy chế / hướng dẫn / mẫu tham khảo (khác với DocumentTemplate sinh văn bản ở v0.8) / tệp khác
enum FirmFileCategory {
  POLICY // Quy chế (sổ tay nhân viên, cam kết bảo mật, quy chế lương…)
  GUIDE // Hướng dẫn (hướng dẫn xử lý vụ, hướng dẫn tiếp khách…)
  TEMPLATE // Mẫu tham khảo (bản mẫu luật sư tải về sửa tay, khác với loại sinh bằng docxtemplater)
  REFERENCE // Tệp khác (giấy phép đăng ký kinh doanh, bản scan chứng chỉ hành nghề…)
  CONTRACT // Hợp đồng
  LETTER // Thư tín / công văn
  LICENSE // Giấy phép / chứng chỉ hành nghề
  OTHER_FIRM // Khác
}

model FirmFile {
  id          String           @id @default(cuid())
  name        String
  description String?
  category    FirmFileCategory
  tags        String[]

  path     String
  mimeType String?
  size     Int
  sha256   String?

  uploadedById String
  uploadedBy   User   @relation("FirmFileUploader", fields: [uploadedById], references: [id])

  // Khi bản cũ bị bản mới thay thế, bản cũ trỏ tới id bản mới; danh sách mặc định ẩn các bản bị thay thế
  supersededById String?
  supersededBy   FirmFile?  @relation("FirmFileSupersedes", fields: [supersededById], references: [id])
  supersedes     FirmFile[] @relation("FirmFileSupersedes")

  archivedAt DateTime? // soft delete
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([category, archivedAt, createdAt])
  @@index([supersededById])
}

// v0.27: Trung tâm dịch vụ — thông báo văn phòng (Model độc lập; thông báo pinned làm banner đầu trang)
model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  pinned      Boolean   @default(false)
  publishedAt DateTime  @default(now())
  // Sau khi hết hạn, banner không hiển thị nữa; vẫn giữ trong danh sách
  expiresAt   DateTime?
  authorId    String
  author      User      @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  archivedAt  DateTime? // soft delete
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([pinned, archivedAt, publishedAt])
  @@index([authorId, createdAt])
}

// v0.27: Trung tâm dịch vụ — liên hệ ngoài (tòa án / công chứng / luật sư văn phòng khác…)
enum ExternalContactCategory {
  COURT // Tòa án
  PROSECUTOR // Viện kiểm sát
  POLICE // Công an
  NOTARY // Phòng công chứng
  ARBITRATION // Trung tâm trọng tài
  OTHER_FIRM // Luật sư văn phòng khác
  EXPERT // Chuyên gia giám định / thẩm định giá
  OTHER // Khác
}

enum ExternalContactStatus {
  PENDING_REVIEW // Chờ duyệt
  APPROVED // Đã duyệt
  REJECTED // Đã từ chối
}

model ExternalContact {
  id           String                  @id @default(cuid())
  name         String
  category     ExternalContactCategory
  organization String?
  title        String?
  phone        String?
  email        String?
  wechat       String?
  address      String?
  notes        String?
  tags         String[]

  createdById  String
  createdBy    User                  @relation("ExternalContactCreator", fields: [createdById], references: [id])
  status       ExternalContactStatus @default(APPROVED)
  reviewedById String?
  reviewedBy   User?                 @relation("ExternalContactReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?
  archivedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([category, archivedAt, name])
  @@index([status, archivedAt, createdAt])
  @@index([reviewedById])
  @@index([name])
}

model Person {
  id               String   @id @default(cuid())
  fullName         String   @db.Text
  gender           Gender   @default(MALE)
  birthYear        Int?
  birthMonth       Int?
  birthDay         Int?
  deathYear        Int?
  deathMonth       Int?
  deathDay         Int?
  isDeceased       Boolean  @default(false)
  isInLaw          Boolean  @default(false)
  birthOrder       Int?
  generation       Int?
  otherNames       String?
  avatarUrl        String?
  note             String?
  phoneNumber      String?
  occupation       String?
  currentResidence String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Self-referencing parent-child (one-way)
  fatherId       String?
  father         Person?  @relation("Father", fields: [fatherId], references: [id])
  fatherChildren Person[] @relation("Father")
  motherId       String?
  mother         Person?  @relation("Mother", fields: [motherId], references: [id])
  motherChildren Person[] @relation("Mother")

  // Relationships
  outgoingRelationships Relationship[] @relation("FromRel")
  incomingRelationships Relationship[] @relation("ToRel")

  // Events
  events           Event[]
  // Lineage relations: person as subject, and person as root
  lineagesAsPerson Lineage[] @relation("LineagePerson")
  lineagesAsRoot   Lineage[] @relation("LineageRoot")

  @@index([fullName])
  @@index([generation])
  @@index([gender])
  @@index([birthYear])
  @@index([deathYear])
  @@index([birthOrder])
  @@index([fatherId])
  @@index([motherId])
}

model Relationship {
  id           String       @id @default(cuid())
  fromPersonId String
  toPersonId   String
  type         RelationType
  startYear    Int?
  startMonth   Int?
  startDay     Int?
  endYear      Int?
  endMonth     Int?
  endDay       Int?
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  fromPerson Person @relation("FromRel", fields: [fromPersonId], references: [id])
  toPerson   Person @relation("ToRel", fields: [toPersonId], references: [id])

  @@unique([fromPersonId, toPersonId, type])
  @@index([fromPersonId])
  @@index([toPersonId])
  @@index([type])
}

model Event {
  id        String    @id @default(cuid())
  personId  String?
  type      EventType
  name      String
  eventDate DateTime
  location  String?
  content   String?
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  person Person? @relation(fields: [personId], references: [id])

  @@index([personId])
  @@index([eventDate])
  @@index([type])
}

model WorkTask {
  id          String       @id @default(cuid())
  title       String
  description String?
  projectId   String?
  creatorId   String?
  assigneeId  String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  startDate   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project        Project?            @relation(fields: [projectId], references: [id])
  creator        User?               @relation("CreatedBy", fields: [creatorId], references: [id])
  assignee       User?               @relation("AssignedTo", fields: [assigneeId], references: [id])
  workflowId     String?
  workflow       Workflow?           @relation(fields: [workflowId], references: [id])
  assignments    TaskAssignment[]
  subtasks       SubTask[]
  history        TaskHistory[]
  attachments    TaskAttachment[]
  checklistItems TaskChecklistItem[]
  tags           TaskTag[]
  watchers       TaskWatcher[]
  comments       TaskComment[]

  @@index([projectId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@index([priority])
  timesheets TimesheetEntry[]
}

model SubTask {
  id          String     @id @default(cuid())
  taskId      String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  order       Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  task WorkTask @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@index([status])
}

model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  action    String // e.g., "created", "status_changed", "assigned"
  details   Json?
  createdAt DateTime @default(now())

  task WorkTask @relation(fields: [taskId], references: [id])
  user User?    @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}

model Lineage {
  id           String   @id @default(cuid())
  personId     String
  rootPersonId String
  generation   Int
  path         String // JSON-encoded ancestor path
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  person     Person @relation("LineagePerson", fields: [personId], references: [id], onDelete: Cascade)
  rootPerson Person @relation("LineageRoot", fields: [rootPersonId], references: [id], onDelete: Cascade)

  @@unique([personId, rootPersonId])
  @@index([rootPersonId])
  @@index([generation])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]
  tasks   LegalTask[]  @relation("TeamTasks")

  @@index([name])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?      @db.Decimal(12, 2)
  currency    String?       @db.VarChar(3)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ownerId   String
  owner     User    @relation("ProjectOwner", fields: [ownerId], references: [id])
  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id])

  tasks      WorkTask[]
  members    ProjectMember[]
  workflows  Workflow[]
  milestones ProjectMilestone[]

  @@index([name])
  @@index([status])
  @@index([ownerId])
  @@index([managerId])
  timesheets TimesheetEntry[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectMilestone {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([dueDate])
}

model Workflow {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      WorkflowStatus @default(ACTIVE)
  category    String?
  ownerId     String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  projectId   String?
  project     Project?             @relation(fields: [projectId], references: [id])
  owner       User                 @relation("WorkflowOwner", fields: [ownerId], references: [id])
  steps       WorkflowStep[]
  transitions WorkflowTransition[]
  audits      WorkflowAudit[]      @relation("WorkflowAudits")
  tasks       WorkTask[]

  @@index([name])
  @@index([status])
  @@index([ownerId])
  @@index([projectId])
}

model WorkflowTransition {
  id         String  @id @default(cuid())
  workflowId String
  fromState  String // or enum if needed
  toState    String
  condition  String? // JS expression or rule ID
  action     String? // action to execute
  order      Int     @default(0)

  workflow Workflow @relation(fields: [workflowId], references: [id])

  @@index([workflowId])
  @@index([order])
}

model WorkflowAudit {
  id         String   @id @default(cuid())
  workflowId String
  userId     String?
  fromStepId String?
  toStepId   String?
  action     String
  comment    String?
  createdAt  DateTime @default(now())

  workflow Workflow      @relation("WorkflowAudits", fields: [workflowId], references: [id])
  user     User?         @relation("UserWorkflowAudits", fields: [userId], references: [id])
  fromStep WorkflowStep? @relation("WorkflowStepFromAudits", fields: [fromStepId], references: [id])
  toStep   WorkflowStep? @relation("WorkflowStepToAudits", fields: [toStepId], references: [id])

  @@index([workflowId])
  @@index([userId])
  @@index([fromStepId])
  @@index([toStepId])
  @@index([createdAt])
}

model WorkflowStep {
  id          String     @id @default(cuid())
  workflowId  String
  name        String
  description String?
  order       Int
  status      TaskStatus @default(TODO)
  assigneeId  String?
  dueDate     DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id])
  assignee User?    @relation(fields: [assigneeId], references: [id])

  fromAudits WorkflowAudit[] @relation("WorkflowStepFromAudits")
  toAudits   WorkflowAudit[] @relation("WorkflowStepToAudits")

  @@index([workflowId])
  @@index([assigneeId])
  @@index([status])
}

model Comment {
  id         String   @id @default(cuid())
  content    String
  authorId   String
  entityType String // e.g., "Task", "Event", "Person"
  entityId   String
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([entityType, entityId])
  @@index([authorId])
  @@index([parentId])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  filename  String
  url       String
  mimeType  String
  size      BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task WorkTask @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

model TaskChecklistItem {
  id         String    @id @default(cuid())
  taskId     String
  title      String
  done       Boolean   @default(false)
  order      Int       @default(0)
  dueDate    DateTime?
  assigneeId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  task     WorkTask @relation(fields: [taskId], references: [id])
  assignee User?    @relation(fields: [assigneeId], references: [id])

  @@index([taskId])
  @@index([assigneeId])
}

model TaskTag {
  id        String   @id @default(cuid())
  taskId    String
  tag       String   @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task WorkTask @relation(fields: [taskId], references: [id])

  @@unique([taskId, tag])
  @@index([taskId])
  @@index([tag])
}

model TaskWatcher {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task WorkTask @relation(fields: [taskId], references: [id])
  user User     @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User?    @relation("CommentAuthor", fields: [authorId], references: [id])

  @@index([taskId])
  @@index([authorId])
}

model TaskAssignment {
  id         String           @id @default(cuid())
  taskId     String
  assignerId String
  assigneeId String
  assignedAt DateTime
  dueDate    DateTime?
  status     AssignmentStatus @default(PENDING)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  task     WorkTask @relation(fields: [taskId], references: [id])
  assigner User     @relation("AssignmentMade", fields: [assignerId], references: [id])
  assignee User     @relation("AssignmentReceived", fields: [assigneeId], references: [id])

  @@index([taskId])
  @@index([assignerId])
  @@index([assigneeId])
  @@index([status])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// ============================================================
// Giai đoạn 1 — thương mại: Báo giá / Hợp đồng / Ghi giờ / Chi phí / Quỹ
// (docs/DATA-MODEL.md v0.48 §4.28–§4.32)
// ============================================================

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  REVIEW
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum ContractEventKind {
  CREATED
  SENT
  SIGNED
  ACTIVATED
  RENEWED
  TERMINATED
  EXPIRED
  NOTE
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum TimesheetActivityType {
  CLIENT_WORK
  INTERNAL
  MEETING
  TRAVEL
  ADMIN
  OTHER
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum ExpenseCategory {
  TRAVEL
  HOSPITALITY
  OFFICE
  OUTSOURCING
  EQUIPMENT
  TAX_FEE
  OTHER
}

enum CashAccountType {
  CASH
  BANK
  EWALLET
}

model CashAccount {
  id             String         @id @default(cuid())
  name           String
  type           CashAccountType
  currency       String         @default("VND")
  openingBalance Decimal        @default(0) @db.Decimal(14, 2)
  bankName       String?
  accountNoMasked String?
  active         Boolean        @default(true)
  note           String?
  feeEntries     FeeEntry[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([active])
}

model Quote {
  id              String      @id @default(cuid())
  code            String      @unique
  title           String
  status          QuoteStatus @default(DRAFT)
  currency        String      @default("VND")
  issuedAt        DateTime?
  expiresAt       DateTime?
  validDays       Int         @default(30)
  subtotal        Decimal     @default(0) @db.Decimal(14, 2)
  discountPercent Decimal     @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal     @default(0) @db.Decimal(5, 2)
  total           Decimal     @default(0) @db.Decimal(14, 2)
  note            String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  matterId String?
  matter   Matter? @relation(fields: [matterId], references: [id])

  intakeId String?
  intake   Intake? @relation(fields: [intakeId], references: [id])

  contractId String?
  contract   Contract? @relation("QuoteContract", fields: [contractId], references: [id])
  contractsFromQuote Contract[] @relation("ContractQuote")

  ownerUserId String?
  ownerUser   User?   @relation("QuoteOwner", fields: [ownerUserId], references: [id])

  createdById String?
  createdBy   User?   @relation("QuoteCreator", fields: [createdById], references: [id])

  items    QuoteItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@index([status, createdAt])
  @@index([clientId])
  @@index([ownerUserId])
  @@index([intakeId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name        String
  description String?
  unit        String?
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @default(0) @db.Decimal(14, 2)
  amount      Decimal @default(0) @db.Decimal(14, 2)
  orderIndex  Int     @default(0)

  @@index([quoteId])
}

model Contract {
  id              String         @id @default(cuid())
  code            String         @unique
  title           String
  status          ContractStatus @default(DRAFT)
  amount          Decimal        @default(0) @db.Decimal(14, 2)
  currency        String         @default("VND")
  scope           String?        @db.Text
  paymentTerms    String?        @db.Text
  termNote        String?        @db.Text
  signedAt        DateTime?
  effectiveAt     DateTime?
  expiresAt       DateTime?
  renewRemindDays Int            @default(30)

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  quoteId String?
  quote   Quote?  @relation("ContractQuote", fields: [quoteId], references: [id])
  convertedQuotes Quote[] @relation("QuoteContract")

  matterId String?
  matter   Matter? @relation(fields: [matterId], references: [id])

  documentId String?
  document   Document? @relation("ContractDocument", fields: [documentId], references: [id])

  ownerUserId String?
  ownerUser   User?   @relation("ContractOwner", fields: [ownerUserId], references: [id])

  createdById String?
  createdBy   User?   @relation("ContractCreator", fields: [createdById], references: [id])

  events    ContractEvent[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  @@index([status, expiresAt])
  @@index([clientId])
  @@index([quoteId])
  @@index([ownerUserId])
}

model ContractEvent {
  id          String             @id @default(cuid())
  contractId  String
  contract    Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind        ContractEventKind
  occurredAt  DateTime           @default(now())
  actorUserId String?
  actorUser   User?              @relation("ContractEventActor", fields: [actorUserId], references: [id])
  detail      String?

  @@index([contractId, occurredAt])
}

model TimesheetEntry {
  id           String                 @id @default(cuid())
  userId       String
  user         User                   @relation("TimesheetUser", fields: [userId], references: [id])
  matterId     String?
  matter       Matter?                @relation(fields: [matterId], references: [id])
  legalTaskId  String?
  legalTask    LegalTask?             @relation(fields: [legalTaskId], references: [id])
  workTaskId   String?
  workTask     WorkTask?              @relation(fields: [workTaskId], references: [id])
  projectId    String?
  project      Project?               @relation(fields: [projectId], references: [id])
  date         DateTime               @db.Date
  hours        Decimal                @db.Decimal(5, 2)
  billable     Boolean                @default(true)
  activityType TimesheetActivityType @default(CLIENT_WORK)
  description   String?
  status       TimesheetStatus        @default(DRAFT)
  approvedById String?
  approvedBy   User?                  @relation("TimesheetApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  rejectNote   String?
  createdById  String?
  createdBy    User?                  @relation("TimesheetCreator", fields: [createdById], references: [id])
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([userId, date])
  @@index([matterId, date])
  @@index([status, date])
}

model ExpenseClaim {
  id             String         @id @default(cuid())
  code           String         @unique
  title          String
  category       ExpenseCategory
  amount         Decimal        @db.Decimal(14, 2)
  occurredAt     DateTime       @default(now())
  vendor         String?
  status         ExpenseStatus  @default(DRAFT)
  approvedById   String?
  approvedBy     User?          @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  paidAt         DateTime?
  receiptDocId   String?
  receipt        Document?      @relation("ExpenseReceipt", fields: [receiptDocId], references: [id])
  note           String?

  matterId       String?
  matter         Matter?        @relation(fields: [matterId], references: [id])

  claimantUserId String
  claimantUser   User           @relation("ExpenseClaimant", fields: [claimantUserId], references: [id])

  submittedById  String?
  submittedBy    User?          @relation("ExpenseSubmitter", fields: [submittedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, createdAt])
  @@index([claimantUserId, occurredAt])
  @@index([matterId])
}

// ============================================================
// Giai đoạn 2 (TD-D2): Nghỉ phép
// ============================================================

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MARITAL
  MATERNITY
  PATERNITY
  COMPENSATORY
  OTHER
}

enum LeaveStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation("LeaveRequester", fields: [userId], references: [id])
  leaveType  LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  // Số ngày nghỉ (bước 0.5), tính khi ghi từ khoảng ngày.
  days       Decimal     @db.Decimal(4, 2)
  reason     String?
  status     LeaveStatus @default(SUBMITTED)

  approverId String?
  approver   User?       @relation("LeaveApprover", fields: [approverId], references: [id])
  decidedAt  DateTime?
  decisionNote String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, status, startDate])
  @@index([status, startDate])
  @@index([approverId, status])
}
